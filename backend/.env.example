# Copy this file to .env and fill in the values.
# Minimum required: LIVEKIT_URL, LIVEKIT_API_KEY, LIVEKIT_API_SECRET,
# SARVAM_API_KEY, MONGODB_URI, JWT_SECRET.
# Every other setting is optional and falls back to app/config.py defaults.

# LiveKit project (required)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=clinic-receptionist

# Sarvam speech (STT, LLM, TTS)
SARVAM_API_KEY=
# Optional: override the analysis LLM base URL.
# Automatically uses https://api.sarvam.ai/v1 for
# ANALYSIS_MODEL=sarvam-105b-conversations.
# SARVAM_LLM_BASE_URL=https://api.sarvam.ai/v2

# MongoDB (replica set required for booking transactions)
# Atlas example:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Local replica-set example:
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGODB_DATABASE=clinic_voice_ai

# Clinic local timezone and API CORS
CLINIC_TIMEZONE=Asia/Kolkata
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Streaming STT
STT_LANGUAGE=hi-IN
STT_STREAM_TYPE=balanced
STT_MODE=codemix
# Keep "vad": the agent relies on Sarvam's server-side turn detection.
STT_ENDPOINTING=vad
# Ask the caller to repeat when speech ends without a final transcript.
STT_TRANSCRIPTION_TIMEOUT=6.0

# Agent LLM
LLM_MODEL=sarvam-105b

# Streaming TTS
TTS_LANGUAGE=hi-IN
TTS_MODEL=bulbul:v3
TTS_SPEAKER=shubh
TTS_PACE=1.0
TTS_MIN_BUFFER_SIZE=50
TTS_MAX_CHUNK_LENGTH=150

# Voice activity detection (Silero, aligned with Sarvam realtime VAD)
# 0.10 s avoids coughs/clicks starting a turn; 0.40 s finds speech end early,
# while the 0.50 s endpointing delay confirms the turn and gives Sarvam time
# to deliver its final transcript. Keep silence >= 0.25 s for the turn detector.
VAD_MIN_SPEECH_DURATION=0.10
VAD_MIN_SILENCE_DURATION=0.40
VAD_PREFIX_PADDING_DURATION=0.30
VAD_ACTIVATION_THRESHOLD=0.50
VAD_DEACTIVATION_THRESHOLD=0.35

# Turn handling and barge-in
MIN_ENDPOINTING_DELAY=0.50
MAX_ENDPOINTING_DELAY=2.50
INTERRUPTION_MIN_DURATION=0.5
PREEMPTIVE_TTS=false

# Post-call analysis worker
ANALYSIS_MODEL=sarvam-105b
ANALYSIS_MAX_ATTEMPTS=3
ANALYSIS_POLL_SECONDS=2.0
ANALYSIS_TIMEOUT_SECONDS=20.0
ANALYSIS_WORKER_ENABLED=true
ANALYSIS_TRANSCRIPT_CHARS=6000

# Admin authentication (JWT_SECRET is required, 32+ characters)
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
AUTH_COOKIE_NAME=clinic_access_token

# Cookies: use secure=true and samesite=none only when the API and
# frontend are on different sites without a same-origin proxy.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Observability and rate limiting
LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
RATE_LIMIT_ENABLED=true
# Use X-Forwarded-For for rate-limit keys when behind Render/Vercel.
TRUST_PROXY_HEADERS=true
