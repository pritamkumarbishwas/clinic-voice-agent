# LiveKit project
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=clinic-receptionist

# Sarvam speech (STT, LLM, TTS)
SARVAM_API_KEY=

# MongoDB (replica set required for booking transactions)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=clinic_voice_ai

# Clinic local timezone and API CORS
CLINIC_TIMEZONE=Asia/Kolkata
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Streaming STT
STT_LANGUAGE=hi-IN
STT_STREAM_TYPE=balanced
STT_MODE=codemix
STT_ENDPOINTING=vad

# Agent LLM
LLM_MODEL=sarvam-105b

# Streaming TTS
TTS_LANGUAGE=hi-IN
TTS_MODEL=bulbul:v3
TTS_SPEAKER=shubh
TTS_PACE=1.0
TTS_MIN_BUFFER_SIZE=50
TTS_MAX_CHUNK_LENGTH=150

# Turn handling and barge-in
MIN_ENDPOINTING_DELAY=0.5
MAX_ENDPOINTING_DELAY=3.0
INTERRUPTION_MIN_DURATION=0.5
PREEMPTIVE_TTS=false

# Post-call analysis worker
ANALYSIS_MODEL=sarvam-105b
ANALYSIS_MAX_ATTEMPTS=3
ANALYSIS_POLL_SECONDS=2.0
ANALYSIS_TIMEOUT_SECONDS=20.0
ANALYSIS_WORKER_ENABLED=true
ANALYSIS_TRANSCRIPT_CHARS=6000
